# Use 2025-version as the root
DirectoryIndex /2025-version/index.html

# Redirect asset requests to the 2025-version directory
RewriteEngine On
  
# Send www visitors to the main address (lowevoice.com)
RewriteCond %{HTTP_HOST} ^www\.lowevoice\.com$ [NC]
RewriteRule ^(.*)$ https://lowevoice.com/$1 [R=301,L]

# Only process requests for assets that don't exist in the root
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect those asset requests to the 2025-version directory
RewriteRule ^assets/(.*)$ /2025-version/assets/$1 [L]

# Clean up broken links to index.html
RewriteRule ^index\.html$ / [R=301,L]

# Long cache lifetimes for static assets
AddType font/woff2 .woff2
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Make MP3 links download instead of playing in a new tab
<FilesMatch "\.mp3$">
    Header set Content-Disposition "attachment"
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>